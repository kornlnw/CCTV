# Apex domain — main site, served by the Next.js app
{$DOMAIN} {
    encode zstd gzip

    @blocked {
        path /.env*
        path /docker-compose*
        path /Dockerfile
    }
    respond @blocked 404

    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format console
    }
}

# www.* — permanent redirect to the apex domain
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
