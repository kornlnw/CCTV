# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Local dev (matches docker-compose host port 5434).
# On VPS, point this at your production Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/cctv_shop?schema=public"

# ─────────────────────────────────────────────────────────────
# LINE Messaging API
# developers.line.biz/console → your provider → Messaging API channel
# ─────────────────────────────────────────────────────────────
# Basic settings tab → Channel secret
LINE_CHANNEL_SECRET=""
# Messaging API tab → Channel access token (long-lived) → Issue
LINE_CHANNEL_ACCESS_TOKEN=""

# ─────────────────────────────────────────────────────────────
# Anthropic Claude API
# console.anthropic.com → Settings → API Keys
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Model used by the chat agent. Cheaper: claude-haiku-4-5. Quality: claude-sonnet-4-6.
CLAUDE_MODEL="claude-sonnet-4-6"

# ─────────────────────────────────────────────────────────────
# Google Calendar (optional — bot still works without it)
# Google Cloud Console → service account → JSON key
# Then SHARE your booking calendar with the service account email
# (give it "Make changes to events" permission).
# ─────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Paste the full -----BEGIN PRIVATE KEY----- ... line.
# In .env, escape newlines as \n (not literal newlines).
GOOGLE_PRIVATE_KEY=""
# "primary" = main calendar of the service account (rarely useful).
# Better: create a "CCTV Bookings" calendar, share it with the service
# account, and paste its calendar ID here (Settings → Integrate → Calendar ID).
GOOGLE_CALENDAR_ID="primary"

# ─────────────────────────────────────────────────────────────
# Payment (PromptPay + bank fallback)
# ─────────────────────────────────────────────────────────────
# Phone: country code + number, no leading 0 (e.g. 66812345678)
# OR 13-digit Thai national ID
PROMPTPAY_ID=""
# Shown to the customer in chat — name, bank, account number.
# e.g. "ธนาคารกสิกรไทย 123-4-56789-0 ชื่อบัญชี ABC จำกัด"
BANK_FALLBACK_TEXT=""

# ─────────────────────────────────────────────────────────────
# Shop branding
# ─────────────────────────────────────────────────────────────
SHOP_NAME="CCTV Shop"

# ─────────────────────────────────────────────────────────────
# Admin auth
# ─────────────────────────────────────────────────────────────
# Password to log into /admin. Pick something strong — this is the
# only thing standing between the public internet and your dashboard.
ADMIN_PASSWORD=""
# Random secret used to sign admin session cookies. Generate with:
#   openssl rand -base64 32
# Must be at least 32 chars. CHANGE this between dev and prod.
ADMIN_SESSION_SECRET=""
# Optional: emails of admin users (reserved for future SSO).
ADMIN_EMAILS="trustx23@protonmail.com"
# Your personal LINE userId (the bot pushes notifications + discount-approval
# buttons to this account). To get it: send any message to your OA, check the
# server logs for ev.source.userId, paste it here. Starts with "U".
ADMIN_LINE_USER_ID=""

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (image uploads for products / packages / slips)
# dash.cloudflare.com → R2 → Create bucket → Manage API tokens
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public URL of the bucket. Either:
#   - the dev URL: https://pub-xxxxxxxx.r2.dev
#   - or your custom domain mapped to the bucket: https://cdn.yourshop.com
R2_PUBLIC_URL=""

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# Used for links inside admin LINE notifications.
# Local: http://localhost:3000   Prod: https://bot.yourshop.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Production deployment (only used by docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────
# Public domain Caddy will obtain a TLS cert for. Must point at this VPS.
DOMAIN="bot.yourshop.com"
# Postgres credentials INSIDE the docker network. The DATABASE_URL above
# is overridden by docker-compose.prod.yml when running in prod.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="cctv_shop"
